VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
# ── Pendientes system ──────────────────────────────────
# Contraseña para el panel de Alexandra (/admin) — solo server-side, nunca en el bundle
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Tokens de acceso (van en la URL /g?t=TOKEN y /i?t=TOKEN)
VITE_GUSTAVO_TOKEN=
VITE_IRAZU_TOKEN=

# Token de acceso al reporte diario (/reporte?t=TOKEN)
VITE_REPORTE_TOKEN=

# Token de acceso al presupuesto simple (/?t=TOKEN)
VITE_PRESUPUESTO_TOKEN=

# Tokens de acceso a la subida de fotos/video de obra (/obra-fotos?t=TOKEN), uno por trabajador
VITE_FABRIEL_TOKEN=
VITE_MISAEL_TOKEN=

# Supabase service role key (para funciones Netlify)
# Supabase → Settings → API → service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp (Sandbox mientras se activa Meta API)
# Twilio → Console → Messaging → Try it out → WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
GUSTAVO_WHATSAPP=

# Token server-side (igual al VITE_GUSTAVO_TOKEN)
GUSTAVO_TOKEN=

# WhatsApp de Alexandra para notificaciones cuando Gustavo responde
ALEXANDRA_WHATSAPP=

# ── Solo Cloudflare Pages / producción — NO están en el .env local ──
# Usadas por las Cloudflare Functions de sync a Google Sheets (functions/api/sync-*.js)
# Cuenta de servicio de Google (contenido completo del JSON), y el ID de la hoja
# "Control de Obra - Horma" a la que se sincroniza.
GOOGLE_SERVICE_ACCOUNT_JSON=
CONTROL_OBRA_SHEET_ID=
